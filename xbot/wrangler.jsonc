{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hhhl-xbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-08",
  "kv_namespaces": [
    {
      "binding": "XBOT_STATE",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BRIDGE",
        "class_name": "BridgeObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BridgeObject"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
